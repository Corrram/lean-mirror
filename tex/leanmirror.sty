%% leanmirror.sty -- mark a LaTeX article as compiled by LeanMirror.
%%
%% LeanMirror reads the article source itself: its sentences, formulas and the
%% macros of the preamble. This package does not change the typeset document
%% and LeanMirror does not read any markup from it; meaning comes only from the
%% article's own definitions and the fixed grammar. It
%%   * loads the packages for the notation the grammar reads (\coloneqq from
%%     mathtools, \mathbb and \le from amssymb),
%%   * records that the article is checked by LeanMirror (\leanmirrorcheck), so
%%     that editors and CI can find the Lean module and certificate report.
%%
%% Usage, in the preamble:
%%   \usepackage{leanmirror}
%%   \leanmirrorcheck{Papers.Rockel2026ExactBlest.Source.Certified}
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{leanmirror}[2026/10/13 v0.1 LeanMirror article marker]
\RequirePackage{mathtools}
\RequirePackage{amssymb}
% The Lean module whose #mirror_certify checks this article (no typeset output).
\newcommand*\leanmirrorcheck[1]{\gdef\leanmirror@module{#1}}
\newcommand*\leanmirror@module{}
\endinput
